  "h_alt": {
    "message": "alternatives; <code>( )</code> captures, used as <code>{1}</code> in the tab name, like zmv"
  },
  "h_auto_k": {
    "message": "Without <code>( )</code>"
  },
  "h_auto": {
    "message": "every <code>*</code> / <code>?</code> / <code>[…]</code> captures (zmv -W)"
  },
  "h_case": {
    "message": "prefix: ignore case (zsh glob flag)"
  },
  "h_regex": {
    "message": "JS regex, partial match; named group <code>(?&lt;k&gt;…)</code> is <code>{&lt;k&gt;}</code>"
  },
  "h_titlef": {
    "message": "prefix: match the original title instead of the URL"
  },
  "h_name": {
