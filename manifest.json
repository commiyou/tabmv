{
  "manifest_version": 3,
  "name": "tabmv - rename tabs with glob/regex",
  "short_name": "tabmv",
  "version": "0.2.0",
  "description": "Rename tab titles and favicons with zmv-style glob or regex rules, e.g. *[?&]env=(*).baidu.com* => $1",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/rules.js",
        "src/store.js",
        "src/picker.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "tabmv：给这个标签改名"
  },
  "options_page": "src/options.html",
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "打开改名面板"
    }
  },
  "side_panel": {
    "default_path": "src/panel.html"
  }
}
